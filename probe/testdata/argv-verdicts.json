  {"name": "mysql -p glued, a lowercase passphrase", "argv": ["mysql", "-pcorrecthorsebattery"], "secrets": ["correcthorsebattery"], "keep": []},
  {"name": "mysql -p glued, a short password with a symbol", "argv": ["mysql", "-uroot", "-pHunter2!"], "secrets": ["Hunter2!"], "keep": ["-uroot"]},
