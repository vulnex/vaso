  {"name": "credential flag, = form", "argv": ["acme", "--api-key=Zq8wX3mK9pL2vB7nR4tY6uI1"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI1"], "keep": ["--api-key="]},
  {"name": "credential flag, separate", "argv": ["acme", "--token", "Zq8wX3mK9pL2vB7nR4tY6uI2"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI2"], "keep": ["--token"]},
  {"name": "mysql -p glued, a date-like password", "argv": ["mysql", "-u", "root", "-p2024.11.05"], "secrets": ["2024.11.05"], "keep": ["-u", "root"]},
