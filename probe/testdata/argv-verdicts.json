  {"name": "mysql -p separate, a credential-looking value is still one", "argv": ["mysql", "-u", "root", "-p", "Xk9mP2qR7vL4wZt8Hn3"], "secrets": ["Xk9mP2qR7vL4wZt8Hn3"], "keep": ["root"]},
