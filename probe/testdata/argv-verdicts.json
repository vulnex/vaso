{
 "about": "Shared argv rules (dt21 round 3). Each case is an argv array (MCP server args, element 0 the command) or a command string. 'secrets' are the credential values (exact substrings) the probe disguises, the report masker masks and MCP-003 reports; 'keep' are elements or substrings that must stay as written. Rules: (1) a following element is a flag, not a value, only when flag-shaped (^--?[A-Za-z][A-Za-z0-9_-]*$ AND the name after the dashes does not look random: looksRandom(name, 12) false, so -Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc is a value while -v, -pthread, --no-auth are flags) or exactly '--' (end of options; what follows is a positional, no flag's value); any other '-'-led element is a value. (2) -p after a password client (mysql, mysqldump, mariadb, mariadb-dump, mysqladmin, sshpass) is a password, separate or glued, unless a reference; psql/pg_dump/redis-cli -p is a port; after any other command -p <v> is a password only when v looks like a credential (MCP-003's looksLikeSecret) and is no port, port mapping, version, package spec, reference or lowercase word. (3) -k <v> is a credential when v looks random (looksRandom, 16) and is no URL, host[:port] or path (isPathValue); '/' and '+' inside do not exclude it. (4) redis-cli -a <v> is a password unless a reference.",
 "cases": [
  {"name": "dash-led value after a credential flag", "argv": ["acme", "--api-key", "-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": ["--api-key"]},
  {"name": "dash-led password", "argv": ["acme", "--password", "-Pz9Lm2Qr7Xv4Kt8Wn3Yb5"], "secrets": ["-Pz9Lm2Qr7Xv4Kt8Wn3Yb5"], "keep": ["--password"]},
  {"name": "secret-named switch before the credential flag", "argv": ["acme", "--no-auth", "--api-key", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": ["--no-auth", "--api-key"]},
  {"name": "two credential flags in a row", "argv": ["acme", "--token", "--api-key", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hd"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hd"], "keep": ["--token", "--api-key"]},
  {"name": "credential flag followed by a short flag", "argv": ["acme", "--token", "-v", "server.js"], "secrets": [], "keep": ["--token", "-v", "server.js"]},
  {"name": "end of options after a credential flag", "argv": ["node", "--token", "--", "server.js"], "secrets": [], "keep": ["--token", "--", "server.js"]},
  {"name": "credential flag, = form", "argv": ["acme", "--api-key=Zq8wX3mK9pL2vB7nR4tY6uI1"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI1"], "keep": ["--api-key="]},
  {"name": "credential flag, separate", "argv": ["acme", "--token", "Zq8wX3mK9pL2vB7nR4tY6uI2"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI2"], "keep": ["--token"]},

  {"name": "mysql -p glued, a date-like password", "argv": ["mysql", "-u", "root", "-p2024.11.05"], "secrets": ["2024.11.05"], "keep": ["-u", "root"]},
  {"name": "mysql -p separate, a date-like password", "argv": ["mysql", "-u", "root", "-p", "2024.11.05", "app"], "secrets": ["2024.11.05"], "keep": ["root", "app"]},
  {"name": "mysql -p glued, a lowercase passphrase", "argv": ["mysql", "-pcorrecthorsebattery"], "secrets": ["correcthorsebattery"], "keep": []},
  {"name": "mysql -p glued, a short password with a symbol", "argv": ["mysql", "-uroot", "-pHunter2!"], "secrets": ["Hunter2!"], "keep": ["-uroot"]},
  {"name": "mysqldump -p separate", "argv": ["mysqldump", "-p", "s3cr3tpass", "db"], "secrets": ["s3cr3tpass"], "keep": ["db"]},
  {"name": "mariadb -p glued", "argv": ["mariadb", "-pXq9Zr7Lm2Pv"], "secrets": ["Xq9Zr7Lm2Pv"], "keep": []},
  {"name": "mysqladmin -p glued", "argv": ["mysqladmin", "-u", "root", "-pabc12345", "status"], "secrets": ["abc12345"], "keep": ["status"]},
  {"name": "mysql via a full path", "argv": ["/usr/local/bin/mysql", "-pTr0ub4dor3x"], "secrets": ["Tr0ub4dor3x"], "keep": []},
  {"name": "mysql -p with a variable reference", "argv": ["mysql", "-p$MYSQL_PWD"], "secrets": [], "keep": ["-p$MYSQL_PWD"]},
  {"name": "mysql -p separate with a ${} reference", "argv": ["mysql", "-p", "${DB_PASS}"], "secrets": [], "keep": ["${DB_PASS}"]},
  {"name": "sshpass -p separate, a lowercase password", "argv": ["sshpass", "-p", "letmeinplease", "ssh", "host"], "secrets": ["letmeinplease"], "keep": ["ssh", "host"]},
  {"name": "sshpass -p glued", "argv": ["sshpass", "-pletmeinplease2", "ssh", "host"], "secrets": ["letmeinplease2"], "keep": ["ssh", "host"]},
  {"name": "sshpass -p separate, a short password with a symbol", "argv": ["sshpass", "-p", "Tz4!kLm8Qw", "ssh", "host"], "secrets": ["Tz4!kLm8Qw"], "keep": ["ssh", "host"]},
  {"name": "mysql -p separate, a short password with a symbol", "argv": ["mysql", "-u", "root", "-p", "Mx8!pQrSt"], "secrets": ["Mx8!pQrSt"], "keep": ["root"]},
  {"name": "psql -p is a port", "argv": ["psql", "-h", "db", "-p", "5432", "-U", "app"], "secrets": [], "keep": ["5432", "app"]},
  {"name": "pg_dump -p is a port", "argv": ["pg_dump", "-p", "5433", "db"], "secrets": [], "keep": ["5433"]},
  {"name": "docker -p port mapping", "argv": ["docker", "run", "-p", "127.0.0.1:8080:80", "img"], "secrets": [], "keep": ["127.0.0.1:8080:80"]},
  {"name": "docker -p glued port mapping", "argv": ["docker", "run", "-p8080:80", "img"], "secrets": [], "keep": ["-p8080:80"]},
  {"name": "npx -p package spec", "argv": ["npx", "-p", "@scope/pkg@1.2.3", "bin"], "secrets": [], "keep": ["@scope/pkg@1.2.3"]},
  {"name": "-p version", "argv": ["uv", "run", "-p", "3.11", "x.py"], "secrets": [], "keep": ["3.11"]},
  {"name": "-p port reference", "argv": ["acme", "-p", "${port}:3000"], "secrets": [], "keep": ["${port}:3000"]},
  {"name": "-p plain port", "argv": ["acme", "-p", "8080"], "secrets": [], "keep": ["8080"]},
  {"name": "-p lowercase word", "argv": ["acme", "-p", "production"], "secrets": [], "keep": ["production"]},
  {"name": "-p random value, unknown command", "argv": ["acme", "-p", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": []},
  {"name": "-p glued random value, unknown command", "argv": ["acme", "-pXq9Zr7Lm2Pv8Kd4Wb6Tn3He"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3He"], "keep": []},
  {"name": "-pthread", "argv": ["gcc", "-pthread", "x.c"], "secrets": [], "keep": ["-pthread"]},

  {"name": "redis-cli -a", "argv": ["redis-cli", "-h", "cache", "-p", "6379", "-a", "letmeinplease"], "secrets": ["letmeinplease"], "keep": ["6379", "cache"]},
  {"name": "redis-cli -a reference", "argv": ["redis-cli", "-a", "$REDIS_PASSWORD"], "secrets": [], "keep": ["$REDIS_PASSWORD"]},

  {"name": "-k random base64 with / and +", "argv": ["acme", "-k", "Xq9/Zr7+Lm2Pv8Kd4Wb6Tn3Hc=="], "secrets": ["Xq9/Zr7+Lm2Pv8Kd4Wb6Tn3Hc=="], "keep": []},
  {"name": "-k random key", "argv": ["acme", "-k", "Zq8wX3mK9pL2vB7nR4tY6uI1"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI1"], "keep": []},
  {"name": "curl -k before a URL", "argv": ["curl", "-k", "https://x.example/api"], "secrets": [], "keep": ["https://x.example/api"]},
  {"name": "-k host:port", "argv": ["acme", "-k", "cache.internal:6379"], "secrets": [], "keep": ["cache.internal:6379"]},
  {"name": "-k path", "argv": ["acme", "-k", "/etc/ssl/private/server.key"], "secrets": [], "keep": ["/etc/ssl/private/server.key"]},
  {"name": "-k word", "argv": ["acme", "-k", "insecure"], "secrets": [], "keep": ["insecure"]},

  {"name": "command string: mysql glued in sh -c, psql port beside it", "command": "sh -c 'mysql -uroot -p2024.11.05 app && psql -p 5432 db'", "secrets": ["2024.11.05"], "keep": ["5432"]},
  {"name": "command string: mysql -p separate", "command": "mysql -u root -p 2024.11.05 app", "secrets": ["2024.11.05"], "keep": ["root", "app"]},
  {"name": "command string: sshpass", "command": "sshpass -p letmeinplease ssh deploy@host", "secrets": ["letmeinplease"], "keep": ["deploy@host"]},
  {"name": "command string: docker port", "command": "docker run -p 8080:80 img", "secrets": [], "keep": ["8080:80"]},
  {"name": "command string: redis-cli -a beside a port", "command": "redis-cli -h cache -p 6379 -a Sup3rS3cretPass", "secrets": ["Sup3rS3cretPass"], "keep": ["6379"]},
  {"name": "command string: switch then credential flag", "command": "npx acme --use-oauth-token --api-key Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hf", "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hf"], "keep": ["--use-oauth-token --api-key "]},
  {"name": "command string: dash-led value", "command": "acme --api-key -Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hg", "secrets": ["-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hg"], "keep": ["--api-key "]}
 ]
}
