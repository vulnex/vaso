{
 "about": "Shared argv rules (dt21 round 3). Each case is an argv array (MCP server args, element 0 the command) or a command string. 'secrets' are the credential values (exact substrings) the probe disguises, the report masker masks and MCP-003 reports; 'keep' are elements or substrings that must stay as written. Rules: (1) a following element is a flag, not a value, only when flag-shaped (^--?[A-Za-z][A-Za-z0-9_-]*$ AND the name after the dashes does not look random: looksRandom(name, 12) false, so -Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc is a value while -v, -pthread, --no-auth are flags) or exactly '--' (end of options; what follows is a positional, no flag's value); any other '-'-led element is a value. (2) -p<v> glued after a password client (mysql, mysqldump, mariadb, mariadb-dump, mysqladmin, sshpass) is a password unless a reference; a separate -p <v> is one only after sshpass (MySQL/MariaDB take the password glued: in mysql -p app_db the client prompts and app_db is the database); psql/pg_dump/redis-cli -p is a port; anywhere else (a MySQL client's separate -p included) -p <v> is a password only when v looks like a credential (MCP-003's looksLikeSecret) and is no port, port mapping, version, package spec, reference or lowercase word; a MySQL/MariaDB client's --password=<v> is its password like a glued -p<v>. (3) -k <v> is a credential when v looks random (looksRandom, 16) and is no URL, host[:port] or path (isPathValue); '/' and '+' inside do not exclude it. (4) redis-cli -a <v> is a password unless a reference. (5) curl -u/--user/--proxy-user (separate, or --user=/--proxy-user=) user:password: the part after the first colon is the password unless empty or a reference; another command's -u (docker -u 1000:1000, --user app:app) is not judged. --pw and --pass are credential flags like --password. (6) MYSQL_PWD=<v>, PGPASSWORD=<v>, SSHPASS=<v>, REDISCLI_AUTH=<v> (a client's password variable) hold a password unless a reference. In a command string, quotes around or inside a word are the shell's (-p\"pw\", -u \"u:pw\", $'...'), at any depth of escaping.",
 "cases": [
  {"name": "dash-led value after a credential flag", "argv": ["acme", "--api-key", "-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": ["--api-key"]},
  {"name": "dash-led password", "argv": ["acme", "--password", "-Pz9Lm2Qr7Xv4Kt8Wn3Yb5"], "secrets": ["-Pz9Lm2Qr7Xv4Kt8Wn3Yb5"], "keep": ["--password"]},
  {"name": "secret-named switch before the credential flag", "argv": ["acme", "--no-auth", "--api-key", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": ["--no-auth", "--api-key"]},
  {"name": "two credential flags in a row", "argv": ["acme", "--token", "--api-key", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hd"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hd"], "keep": ["--token", "--api-key"]},
  {"name": "credential flag followed by a short flag", "argv": ["acme", "--token", "-v", "server.js"], "secrets": [], "keep": ["--token", "-v", "server.js"]},
  {"name": "end of options after a credential flag", "argv": ["node", "--token", "--", "server.js"], "secrets": [], "keep": ["--token", "--", "server.js"]},
  {"name": "credential flag, = form", "argv": ["acme", "--api-key=Zq8wX3mK9pL2vB7nR4tY6uI1"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI1"], "keep": ["--api-key="]},
  {"name": "credential flag, separate", "argv": ["acme", "--token", "Zq8wX3mK9pL2vB7nR4tY6uI2"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI2"], "keep": ["--token"]},
  {"name": "mysql -p glued, a date-like password", "argv": ["mysql", "-u", "root", "-p2024.11.05"], "secrets": ["2024.11.05"], "keep": ["-u", "root"]},
  {"name": "mysql -p separate is the database, not a password (date-like)", "argv": ["mysql", "-u", "root", "-p", "2024.11.05", "app"], "secrets": [], "keep": ["root", "2024.11.05", "app"]},
  {"name": "mysql -p glued, a lowercase passphrase", "argv": ["mysql", "-pcorrecthorsebattery"], "secrets": ["correcthorsebattery"], "keep": []},
  {"name": "mysql -p glued, a short password with a symbol", "argv": ["mysql", "-uroot", "-pHunter2!"], "secrets": ["Hunter2!"], "keep": ["-uroot"]},
  {"name": "mysqldump -p separate is the database", "argv": ["mysqldump", "-p", "s3cr3tpass", "db"], "secrets": [], "keep": ["s3cr3tpass", "db"]},
  {"name": "mysql -p separate, a database name", "argv": ["mysql", "-u", "root", "-p", "app_db"], "secrets": [], "keep": ["root", "app_db"]},
  {"name": "mysql -p separate after host and port", "argv": ["mysql", "-h", "db", "-P", "3306", "-u", "app", "-p", "mydb"], "secrets": [], "keep": ["3306", "app", "mydb"]},
  {"name": "mysql -p separate, a credential-looking value is still one", "argv": ["mysql", "-u", "root", "-p", "Xk9mP2qR7vL4wZt8Hn3"], "secrets": ["Xk9mP2qR7vL4wZt8Hn3"], "keep": ["root"]},
  {"name": "mariadb -p glued", "argv": ["mariadb", "-pXq9Zr7Lm2Pv"], "secrets": ["Xq9Zr7Lm2Pv"], "keep": []},
  {"name": "mysqladmin -p glued", "argv": ["mysqladmin", "-u", "root", "-pabc12345", "status"], "secrets": ["abc12345"], "keep": ["status"]},
  {"name": "mysql via a full path", "argv": ["/usr/local/bin/mysql", "-pTr0ub4dor3x"], "secrets": ["Tr0ub4dor3x"], "keep": []},
  {"name": "mysql -p with a variable reference", "argv": ["mysql", "-p$MYSQL_PWD"], "secrets": [], "keep": ["-p$MYSQL_PWD"]},
  {"name": "mysql -p separate with a ${} reference", "argv": ["mysql", "-p", "${DB_PASS}"], "secrets": [], "keep": ["${DB_PASS}"]},
  {"name": "sshpass -p separate, a lowercase password", "argv": ["sshpass", "-p", "letmeinplease", "ssh", "host"], "secrets": ["letmeinplease"], "keep": ["ssh", "host"]},
  {"name": "sshpass -p glued", "argv": ["sshpass", "-pletmeinplease2", "ssh", "host"], "secrets": ["letmeinplease2"], "keep": ["ssh", "host"]},
  {"name": "sshpass -p separate, a short password with a symbol", "argv": ["sshpass", "-p", "Tz4!kLm8Qw", "ssh", "host"], "secrets": ["Tz4!kLm8Qw"], "keep": ["ssh", "host"]},
  {"name": "mysql -p separate, a short word is the database", "argv": ["mysql", "-u", "root", "-p", "Mx8!pQrSt"], "secrets": [], "keep": ["root", "Mx8!pQrSt"]},
  {"name": "psql -p is a port", "argv": ["psql", "-h", "db", "-p", "5432", "-U", "app"], "secrets": [], "keep": ["5432", "app"]},
  {"name": "pg_dump -p is a port", "argv": ["pg_dump", "-p", "5433", "db"], "secrets": [], "keep": ["5433"]},
  {"name": "docker -p port mapping", "argv": ["docker", "run", "-p", "127.0.0.1:8080:80", "img"], "secrets": [], "keep": ["127.0.0.1:8080:80"]},
  {"name": "docker -p glued port mapping", "argv": ["docker", "run", "-p8080:80", "img"], "secrets": [], "keep": ["-p8080:80"]},
  {"name": "npx -p package spec", "argv": ["npx", "-p", "@scope/pkg@1.2.3", "bin"], "secrets": [], "keep": ["@scope/pkg@1.2.3"]},
  {"name": "-p version", "argv": ["uv", "run", "-p", "3.11", "x.py"], "secrets": [], "keep": ["3.11"]},
  {"name": "-p port reference", "argv": ["acme", "-p", "${port}:3000"], "secrets": [], "keep": ["${port}:3000"]},
  {"name": "-p plain port", "argv": ["acme", "-p", "8080"], "secrets": [], "keep": ["8080"]},
  {"name": "-p lowercase word", "argv": ["acme", "-p", "production"], "secrets": [], "keep": ["production"]},
  {"name": "-p random value, unknown command", "argv": ["acme", "-p", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hc"], "keep": []},
  {"name": "-p glued random value, unknown command", "argv": ["acme", "-pXq9Zr7Lm2Pv8Kd4Wb6Tn3He"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3He"], "keep": []},
  {"name": "-pthread", "argv": ["gcc", "-pthread", "x.c"], "secrets": [], "keep": ["-pthread"]},
  {"name": "redis-cli -a", "argv": ["redis-cli", "-h", "cache", "-p", "6379", "-a", "letmeinplease"], "secrets": ["letmeinplease"], "keep": ["6379", "cache"]},
  {"name": "redis-cli -a reference", "argv": ["redis-cli", "-a", "$REDIS_PASSWORD"], "secrets": [], "keep": ["$REDIS_PASSWORD"]},
  {"name": "-k random base64 with / and +", "argv": ["acme", "-k", "Xq9/Zr7+Lm2Pv8Kd4Wb6Tn3Hc=="], "secrets": ["Xq9/Zr7+Lm2Pv8Kd4Wb6Tn3Hc=="], "keep": []},
  {"name": "-k random key", "argv": ["acme", "-k", "Zq8wX3mK9pL2vB7nR4tY6uI1"], "secrets": ["Zq8wX3mK9pL2vB7nR4tY6uI1"], "keep": []},
  {"name": "curl -k before a URL", "argv": ["curl", "-k", "https://x.example/api"], "secrets": [], "keep": ["https://x.example/api"]},
  {"name": "-k host:port", "argv": ["acme", "-k", "cache.internal:6379"], "secrets": [], "keep": ["cache.internal:6379"]},
  {"name": "-k path", "argv": ["acme", "-k", "/etc/ssl/private/server.key"], "secrets": [], "keep": ["/etc/ssl/private/server.key"]},
  {"name": "-k word", "argv": ["acme", "-k", "insecure"], "secrets": [], "keep": ["insecure"]},
  {"name": "command string: mysql glued in sh -c, psql port beside it", "command": "sh -c 'mysql -uroot -p2024.11.05 app && psql -p 5432 db'", "secrets": ["2024.11.05"], "keep": ["5432"]},
  {"name": "command string: mysql -p separate is the database", "command": "mysql -u root -p 2024.11.05 app", "secrets": [], "keep": ["root", "2024.11.05", "app"]},
  {"name": "command string: mysql -p app_db prompts", "command": "mysql -u root -p app_db", "secrets": [], "keep": ["root", "app_db"]},
  {"name": "command string: mysql glued beside sshpass separate", "command": "mysql -uroot -pGlu3dPw0rd app && sshpass -p letmeinplease ssh host", "secrets": ["Glu3dPw0rd", "letmeinplease"], "keep": ["app", "host"]},
  {"name": "command string: sshpass", "command": "sshpass -p letmeinplease ssh deploy@host", "secrets": ["letmeinplease"], "keep": ["deploy@host"]},
  {"name": "command string: docker port", "command": "docker run -p 8080:80 img", "secrets": [], "keep": ["8080:80"]},
  {"name": "command string: redis-cli -a beside a port", "command": "redis-cli -h cache -p 6379 -a Sup3rS3cretPass", "secrets": ["Sup3rS3cretPass"], "keep": ["6379"]},
  {"name": "command string: switch then credential flag", "command": "npx acme --use-oauth-token --api-key Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hf", "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hf"], "keep": ["--use-oauth-token --api-key "]},
  {"name": "command string: dash-led value", "command": "acme --api-key -Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hg", "secrets": ["-Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hg"], "keep": ["--api-key "]},
  {"name": "curl -u and --user as separate elements", "argv": ["curl", "-u", "carol:curlpw2low", "--user", "dave:userpwlow", "https://x.example/api"], "secrets": ["curlpw2low", "userpwlow"], "keep": ["carol:", "dave:", "https://x.example/api"]},
  {"name": "curl --proxy-user separate", "argv": ["curl", "--proxy-user", "proxyuser:Pr0xyPassw0rd", "https://x.example"], "secrets": ["Pr0xyPassw0rd"], "keep": ["proxyuser:"]},
  {"name": "curl --user= form", "argv": ["curl", "--user=erin:hunter2abc", "https://x.example"], "secrets": ["hunter2abc"], "keep": ["--user=erin:"]},
  {"name": "curl via a full path, a short password", "argv": ["/usr/bin/curl", "-u", "bob:pw1", "https://x.example"], "secrets": ["pw1"], "keep": ["bob:"]},
  {"name": "curl -u with a reference", "argv": ["curl", "-u", "bob:$CURL_PASSWORD", "https://x.example"], "secrets": [], "keep": ["bob:$CURL_PASSWORD"]},
  {"name": "curl -u user only", "argv": ["curl", "-u", "bob", "https://x.example"], "secrets": [], "keep": ["bob"]},
  {"name": "curl -u empty password", "argv": ["curl", "-u", "bob:", "https://x.example"], "secrets": [], "keep": ["bob:"]},
  {"name": "docker --user uid:gid is not a password", "argv": ["docker", "run", "--user", "1000:1000", "img"], "secrets": [], "keep": []},
  {"name": "--pw credential flag", "argv": ["acme", "--pw", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hk"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hk"], "keep": ["--pw"]},
  {"name": "--pass credential flag", "argv": ["acme", "--pass", "Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hm"], "secrets": ["Xq9Zr7Lm2Pv8Kd4Wb6Tn3Hm"], "keep": ["--pass"]},
  {"name": "command string: curl -u", "command": "sh -c 'curl -sS -u carol:Curlpw2Low9 https://x.example/api'", "secrets": ["Curlpw2Low9"], "keep": ["carol:", "https://x.example/api"]},
  {"name": "command string: mysql -p double-quoted glued", "command": "mysql -p\"Top1Quoted9\" app", "secrets": ["Top1Quoted9"], "keep": ["app"]},
  {"name": "command string: mysql -p single-quoted glued", "command": "mysql -p'Top2Single9' app", "secrets": ["Top2Single9"], "keep": ["app"]},
  {"name": "command string: sshpass -p double-quoted separate", "command": "sshpass -p \"Top3Spaced9\" ssh x", "secrets": ["Top3Spaced9"], "keep": ["ssh x"]},
  {"name": "command string: curl -u double-quoted", "command": "curl -u \"adm:Top5Curl9x\" https://x", "secrets": ["Top5Curl9x"], "keep": ["adm:", "https://x"]},
  {"name": "command string: quoted user before a quoted glued password", "command": "mysql -u \"root\" -p\"Rt5Qw8Lm3Zx\" app", "secrets": ["Rt5Qw8Lm3Zx"], "keep": ["root", "app"]},
  {"name": "command string: mysql -p double-quoted inside ssh single quotes", "command": "ssh h 'mysql -p\"Qu0ted9Pass\" app'", "secrets": ["Qu0ted9Pass"], "keep": ["app"]},
  {"name": "command string: sshpass escaped quotes inside ssh double quotes", "command": "ssh h \"sshpass -p \\\"Esc4Pq8Wd\\\" ssh x\"", "secrets": ["Esc4Pq8Wd"], "keep": ["ssh x"]},
  {"name": "command string: ANSI-C quoted remote command", "command": "ssh h $'mysql -pAnsi7Cq3Lw app'", "secrets": ["Ansi7Cq3Lw"], "keep": ["app"]},
  {"name": "command string: two levels of quoting", "command": "ssh host \"bash -c 'mysql -pQx7Lm2Vn9Bz4 app'\"", "secrets": ["Qx7Lm2Vn9Bz4"], "keep": ["app"]},
  {"name": "command string: mysql -p quoted separate is the database", "command": "mysql -u root -p \"app_db\"", "secrets": [], "keep": ["root", "app_db"]},
  {"name": "mysql --password= takes any stored value", "argv": ["mysql", "-u", "root", "--password=Ab12", "app"], "secrets": ["Ab12"], "keep": ["root", "app"]},
  {"name": "mysql --password= reference", "argv": ["mysql", "--password=${DB_PASSWORD}", "app"], "secrets": [], "keep": ["--password=${"]},
  {"name": "command string: mysql --password= double-quoted", "command": "mysql --password=\"Top4Long9x\" app", "secrets": ["Top4Long9x"], "keep": ["app"]},
  {"name": "client password variable in docker -e", "argv": ["docker", "run", "-e", "PGPASSWORD=pg1", "postgres"], "secrets": ["pg1"], "keep": ["PGPASSWORD="]},
  {"name": "command string: MYSQL_PWD quoted", "command": "MYSQL_PWD=\"Top7Env9xx\" mysql app", "secrets": ["Top7Env9xx"], "keep": ["mysql app"]},
  {"name": "command string: PGPASSWORD reference", "command": "PGPASSWORD=$PGPW psql -h db app", "secrets": [], "keep": ["$PGPW"]}
 ]
}
