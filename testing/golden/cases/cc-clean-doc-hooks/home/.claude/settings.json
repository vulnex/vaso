{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Bash|PowerShell",
    "hooks": [
     {
      "type": "command",
      "if": "Bash(rm *)",
      "command": "powershell.exe",
      "args": [
       "-NoProfile",
       "-ExecutionPolicy",
       "Bypass",
       "-File",
       "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-rm.ps1"
      ]
     },
     {
      "type": "command",
      "if": "PowerShell(Remove-Item *)",
      "command": "powershell.exe",
      "args": [
       "-NoProfile",
       "-ExecutionPolicy",
       "Bypass",
       "-File",
       "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-rm.ps1"
      ]
     }
    ]
   }
  ]
 }
}