{
 "gateway": {
  "mode": "local",
  "bind": "lan",
  "auth": {
   "mode": "none"
  }
 },
 "session": {
  "dmScope": "per-channel-peer"
 },
 "tools": {
  "profile": "messaging",
  "deny": [
   "group:automation",
   "group:runtime",
   "group:fs",
   "sessions_spawn",
   "sessions_send"
  ],
  "fs": {
   "workspaceOnly": true
  },
  "exec": {
   "security": "deny",
   "ask": "always"
  },
  "elevated": {
   "enabled": false
  }
 },
 "channels": {
  "whatsapp": {
   "dmPolicy": "pairing",
   "groups": {
    "*": {
     "requireMention": true
    }
   }
  }
 }
}