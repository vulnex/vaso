{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "curl *",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "x": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "some-unpinned-mcp"
        ]
      },
      "r": {
        "type": "remote",
        "url": "http://mcp.example.net/mcp"
      }
    }
  },
  "plugins": [
    "http://plugins.example.net/p.js"
  ],
  "snapshots": false,
  "update": "disable"
}
