# IronClaw 0.x (legacy) secure bootstrap env — ~/.ironclaw/.env
# Keys match ironclaw v0.29.1 src/config. Fake values only.
DATABASE_BACKEND=libsql
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GATEWAY_ENABLED=true
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_WEBHOOK_SECRET=fixture-webhook-secret-not-real
SANDBOX_ENABLED=true
SANDBOX_POLICY=readonly
SANDBOX_AUTO_PULL=false
SANDBOX_IMAGE=ghcr.io/example/ironclaw-worker@sha256:abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
AGENT_AUTO_APPROVE_TOOLS=false
ALLOW_LOCAL_TOOLS=false
TELEGRAM_OWNER_ID=123456789
