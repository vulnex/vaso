# IronClaw secure configuration
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_AUTH_TOKEN=secure-random-token-abc123
GATEWAY_TLS_CERT=/etc/ironclaw/certs/server.crt
GATEWAY_TLS_KEY=/etc/ironclaw/certs/server.key
HTTP_HOST=127.0.0.1
HTTP_PORT=8443
HTTP_TLS_CERT=/etc/ironclaw/certs/http.crt
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=50051
ORCHESTRATOR_TLS_CERT=/etc/ironclaw/certs/orch.crt
SANDBOX_ENABLED=true
SANDBOX_POLICY=restricted
AGENT_AUTO_APPROVE_TOOLS=false
ALLOW_LOCAL_TOOLS=false
TELEGRAM_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
TELEGRAM_OWNER_ID=123456789
SANDBOX_DOCKER_IMAGE=ironclaw/sandbox@sha256:abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
