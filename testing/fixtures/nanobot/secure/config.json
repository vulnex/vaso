{
  "host": "127.0.0.1",
  "port": 18790,
  "restrictToWorkspace": true,
  "channels": {
    "telegram": {
      "enabled": true,
      "allowFrom": ["123456789"],
      "rateLimit": { "maxRequests": 10, "windowMs": 60000 }
    }
  },
  "tools": {
    "exec": {
      "enabled": true,
      "denyList": ["rm", "shutdown", "reboot", "mkfs", "dd", "kill", "killall", "pkill", "halt", "poweroff"]
    },
    "webFetch": {
      "enabled": true,
      "blockedHosts": ["localhost", "127.0.0.1", "0.0.0.0", "169.254.169.254", "10.*", "172.16.*", "192.168.*"]
    }
  },
  "sessions": {
    "encryption": true
  }
}
