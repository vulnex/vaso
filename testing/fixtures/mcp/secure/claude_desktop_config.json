{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.7.1", "/Users/me/projects"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@0.5.1"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "secure-sse": {
      "url": "https://mcp.example.com/sse",
      "env": {
        "MCP_ACCESS_TOKEN": "${MCP_SSE_TOKEN}"
      }
    }
  }
}
