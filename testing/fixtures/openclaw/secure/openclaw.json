{
  "version": "1.6.0",
  "gateway": {
    "host": "127.0.0.1",
    "port": 8080,
    "tls": true,
    "auth": {
      "mode": "token",
      "bypass": false
    }
  },
  "sandbox": {
    "enabled": true,
    "allowedExec": ["ls", "cat", "grep", "head", "tail", "wc", "echo", "date"],
    "allowedPaths": ["/workspace"],
    "networkPolicy": "deny-by-default"
  },
  "security": {
    "safeBins": ["ls", "cat", "grep", "head", "tail", "wc", "echo", "date"]
  },
  "workspace": "/workspace",
  "webhooks": [
    {
      "url": "https://example.com/hook",
      "events": ["agent.start"],
      "secret": "whsec_a1b2c3d4e5f6"
    }
  ],
  "rateLimit": {
    "maxRequests": 100,
    "windowMs": 60000
  },
  "dm": {
    "policy": "restricted"
  },
  "tools": {
    "policy": "allowlist"
  },
  "mdns": false
}
