{
  "name": "vaso",
  "version": "0.4.12",
  "description": "VULNEX Agent Security Observer — agent-agnostic security scanner for AI agent deployments",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "vaso": "bin/vaso",
    "vaso-quick": "bin/vaso-quick.sh"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config testing/vitest.config.integration.ts",
    "test:e2e": "vitest run --config testing/vitest.config.e2e.ts",
    "test:all": "vitest run && npm run test:e2e && npm run test:integration",
    "docker:build-base": "docker build -t vaso-test-base -f testing/docker/base.Dockerfile .",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "security",
    "scanner",
    "ai-agent",
    "openclaw",
    "nanoclaw",
    "picoclaw",
    "ironclaw",
    "nanobot",
    "zeroclaw",
    "nemoclaw",
    "hermes",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "vulnerability"
  ],
  "author": "VULNEX",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vulnex/vaso.git"
  },
  "homepage": "https://github.com/vulnex/vaso",
  "bugs": {
    "url": "https://github.com/vulnex/vaso/issues"
  },
  "files": [
    "dist",
    "bin",
    "probe/checksums.json",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "plist": "^5.0.0",
    "smol-toml": "^1.6.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^2026.1.26",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-memory": "^2026.1.26",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.3.5",
    "@types/plist": "^3.0.5",
    "glob": "^13.0.6",
    "testcontainers": "^11.12.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
