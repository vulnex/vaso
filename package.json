{
  "name": "vaso",
  "version": "0.1.0",
  "description": "VULNEX Agent Security Observer — agent-agnostic security scanner for AI agent deployments",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "vaso": "bin/vaso"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
