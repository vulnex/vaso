{
  "name": "vaso",
  "version": "0.1.0",
  "description": "VULNEX Agent Security Observer — agent-agnostic security scanner for AI agent deployments",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "vaso": "bin/vaso"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config testing/vitest.config.integration.ts",
    "test:e2e": "vitest run --config testing/vitest.config.e2e.ts",
    "test:all": "vitest run && npm run test:e2e && npm run test:integration",
    "docker:build-base": "docker build -t vaso-test-base -f testing/docker/base.Dockerfile .",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "scanner",
    "ai-agent",
    "openclaw",
    "nanoclaw",
    "picoclaw",
    "ironclaw",
    "nanobot",
    "zeroclaw",
    "vulnerability"
  ],
  "author": "VULNEX",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vulnex/vaso.git"
  },
  "homepage": "https://github.com/vulnex/vaso",
  "bugs": {
    "url": "https://github.com/vulnex/vaso/issues"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "smol-toml": "^1.6.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^2025.1.13",
    "@modelcontextprotocol/server-filesystem": "^2025.1.13",
    "@modelcontextprotocol/server-memory": "^2025.1.13",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.1.13",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.13.4",
    "glob": "^11.0.0",
    "testcontainers": "^11.12.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
